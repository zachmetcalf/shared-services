root = true

# defaults
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# bat
[*.bat]
end_of_line = crlf

# json
[*.json]
indent_style = space
indent_size = 4

# yaml
[*.{yml,yaml}]
indent_style = space
indent_size = 2
